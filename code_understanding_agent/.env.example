# API配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
OPENAI_API_KEY=your_openai_api_key_here

# LLVM/Clang配置 (根据系统自动检测，通常不需要手动设置)
# LLVM_PATH=/usr/local/opt/llvm
# LLVM_BIN_PATH=/usr/local/opt/llvm/bin
# CLANG_LIBRARY_PATH=/usr/local/opt/llvm/lib/libclang.dylib

# 性能配置
MAX_WORKERS=4
BATCH_SIZE=100
MAX_FILES_TO_PARSE=100
MAX_FUNCTION_COMPLEXITY=50

# Web界面配置
WEB_HOST=0.0.0.0
WEB_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000

# 日志配置
LOG_LEVEL=INFO

# 嵌入模型配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50